PDF = main.pdf
TEX = main.tex
DEPS = ../shared/macros.tex ../shared/references.bib

$(PDF): $(TEX) $(DEPS)
	latexmk -pdf -interaction=nonstopmode -halt-on-error $(TEX)

# Every computed number the document quotes comes from the COMMITTED
# numerics.yaml, regenerated by (run from the repo root, ~6-8 min):
#   python docs/math/10-mbo-auction-dynamics/check_numerics.py
# `--quick` (~1 min) skips the two 100x96 dense eigendecompositions and writes
# numerics_quick.yaml (gitignored) instead, so it can never replace the committed file.
# See docs/math/AUTHORING_GUIDE.md Section 8b.
numerics:
	cd ../../.. && python docs/math/10-mbo-auction-dynamics/check_numerics.py

clean:
	latexmk -C

.PHONY: clean numerics
